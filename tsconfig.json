{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types", "node"],
    "strict": true, "noEmit": true, "allowJs": true, "checkJs": false, "resolveJsonModule": true, "skipLibCheck": true, "isolatedModules": true
  },
  "include": ["worker/**/*.ts", "shared/**/*.js", "vitest.config.ts"]
}
