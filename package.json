{
  "name": "apicheck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply apicheck --local",
    "db:remote": "wrangler d1 migrations apply apicheck --remote",
    "deploy": "node scripts/build.mjs && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261104.1",
    "@fontsource-variable/funnel-display": "5.3.0",
    "@fontsource-variable/funnel-sans": "5.3.0",
    "@fontsource-variable/sometype-mono": "5.3.0",
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.157.0"
  }
}
